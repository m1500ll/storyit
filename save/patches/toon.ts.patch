+/** today's strollers: no hats, bright casual colours */
+export const modern = (v = 0): Outfit => {
+  const tops = ["#e2453c", "#3f6fb5", "#f0b43c", "#2f8a4f", "#7b5ac9", "#f4f1ea", "#e86e9a"];
+  const hair = ["#5a3b2a", "#2a201a", "#c08a4a", "#7a4a2a", "#e0b860"];
+  return v % 5 === 3 ? { jacket: tops[v % 7], pants: "#3b5b9a", boots: "#f4f1ea", hat: "cap", cap: tops[(v + 3) % 7], skin: SKINS[v % 4] }
