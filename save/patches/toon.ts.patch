+/** UK "no motor vehicles" roundel on a 700 x 520 canvas (circle 500 px; the corners stay transparent) */
+export const fxNoCars = (p: Pen) => {
+  const cx = 350, cy = 260;
+  p.ell(cx, cy, 246, 246, "#d42f2f", 10);
+  p.ell(cx, cy, 196, 196, "#ffffff", 8);
+  // car side view: body, cabin, wheels
+  p.poly(rrect(208, 250, 492, 318, 26), "#1d1b22", 0);
+  p.poly([[262, 252], [300, 196], [408, 196], [446, 252]], "#1d1b22", 0);
+  p.poly([[284, 248], [310, 210], [348, 210], [348, 248]], "#ffffff", 0);
+  p.poly([[362, 248], [362, 210], [398, 210], [426, 248]], "#ffffff", 0);
+  for (const x of [270, 430]) { p.ell(x, 320, 34, 34, "#1d1b22", 0); p.ell(x, 320, 14, 14, "#ffffff", 0); }
+};
