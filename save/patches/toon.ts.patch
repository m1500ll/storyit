+// ---------------- Hammersmith short additions ----------------
+/** the bridge owners: stout gentlemen in top hats with moustaches */
+export const OWNER = (v = 0): Outfit => ({ jacket: v ? "#2f3b52" : "#4a2f3a", pants: "#2e2a36", boots: INK, hat: "tophat", buttons: "#e8c45a",
