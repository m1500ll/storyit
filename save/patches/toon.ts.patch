+/** zigzag crack with chips on a 400 x 400 canvas; t 0..1 grows it */
+export const fxCrack = (p: Pen, t: number) => {
+  const e = Math.min(1, t), pts: [number, number][] = [[200, 30], [182, 92], [214, 140], [176, 206], [206, 262], [168, 322], [190, 372]];
+  const n = Math.max(2, Math.round(2 + e * (pts.length - 2)));
+  p.stroke(pts.slice(0, n), 14, "#241726");
+  if (e > 0.5) p.stroke([[214, 140], [262, 166], [292, 214]], 9, "#241726");
+  if (e > 0.75) p.stroke([[176, 206], [128, 222], [100, 262]], 8, "#241726");
+  if (e > 0.9) for (const [x, y, r] of [[236, 300, 10], [150, 120, 8], [262, 90, 7]]) p.poly([[x - r, y], [x, y - r], [x + r, y + r * 0.4]], "#b8aa97", 4);
+};
+
